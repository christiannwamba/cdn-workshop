  "sources": {
    "cache": {
      "path": "handlers/cache.mjs",
      "first": 8,
      "last": 12,
      "code": " const q=u.searchParams.getAll('q');const content=experiment?`experiment:${variant}`:vary?`language:${language}`:`results:${JSON.stringify(q)}`;\n const event={path:u.pathname,query:[...u.searchParams],rawSearch:u.search,variant,language,content,trackingOnMiss:request.headers.get('x-demo-original-query')||null};\n const fill=await record('origin',namespace,event);\n const headers={'content-type':'text/html; charset=utf-8','cache-control':'public, max-age=0, s-maxage=300','x-origin-fill':fill,'x-origin-content':encodeURIComponent(content)};\n if(experiment)headers.vary='x-demo-variant';if(vary)headers.vary='x-demo-language';",
      "fileSha256": "ddca9006adb43c2e2a27faefb48cd7ead24cd180ff9ad1fb4d069e82fb5b6c6b",
      "displayCode": "const q = u.searchParams.getAll('q');\nconst content = experiment\n  ? `experiment:${variant}`\n  : vary\n    ? `language:${language}`\n    : `results:${JSON.stringify(q)}`;\nconst event = {\n  path: u.pathname,\n  query: [...u.searchParams],\n  rawSearch: u.search,\n  variant,\n  language,\n  content,\n  trackingOnMiss: request.headers.get('x-demo-original-query') || null,\n};\nconst fill = await record('origin', namespace, event);\nconst headers = {\n  'content-type': 'text/html; charset=utf-8',\n  'cache-control': 'public, max-age=0, s-maxage=300',\n  'x-origin-fill': fill,\n  'x-origin-content': encodeURIComponent(content),\n};\nif (experiment) headers.vary = 'x-demo-variant';\nif (vary) headers.vary = 'x-demo-language';\n"
    },
    "rewrite": {
      "path": "proxy.js",
      "first": 9,
      "last": 17,
      "code": " const pairs=[...url.searchParams].filter(([key])=>key!=='utm_source'&&!(isData&&hasRouteParams&&['namespace','identity'].includes(key)));\n // Stable sort preserves the order of duplicate values. Other parameter keys remain in identity.\n pairs.sort((a,b)=>a[0]<b[0]?-1:a[0]>b[0]?1:0);\n const identity=Buffer.from(JSON.stringify(pairs)).toString('base64url');\n if(hasRouteParams&&suppliedIdentity!==identity)return new Response('Invalid framework identity',{status:400});\n if(identity.length>8000)return new Response('Fixture query too long',{status:400});\n url.pathname=`/internal/${namespace}/${identity}`;url.search='';\n const id=crypto.randomUUID();console.log(JSON.stringify({kind:'cache-pack-middleware',id,path:new URL(request.url).pathname}));\n const response=NextResponse.rewrite(url);response.headers.set('x-demo-middleware-id',id);return response;",
